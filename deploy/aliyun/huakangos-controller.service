# HuaKangOS / DealerDesk —— 阿里云 ECS 上的「受信任控制器」systemd 单元
#
# 【这个单元做什么】
#   * 运行 maintenance.supervisor（可信发布状态机）：判断维护窗口、调用飞书审批、
#     拉取候选镜像、切换运行版本、写 PAUSED 标记。
#   * 由它用 docker run 启动/停止业务后端容器（maintenance/deploy/runtime.py 的
#     ContainerRuntime，容器名 MAINT_APP_CONTAINER，默认 huakangos-app）。
#
# 【这个单元不做什么】
#   * 不用 uvicorn 直接跑 app.main:app：业务服务本身是一个**独立容器**，
#     不是本服务的一部分；容器以 --restart=no 创建，生命周期只属于控制器，
#     别的进程不许在控制器背后把它拉起来（见 maintenance/deploy/container.py）。
#   * 不做构建/测试：Docker 构建与隔离测试只在 Setup 阶段由新加坡构建机完成。
#   * 不联网暴露端口：容器只发布到 127.0.0.1（MAINT_APP_PUBLISH_HOST），
#     公网入口由宿主机上的反向代理负责。
#
# 【安装方式】
#   deploy/aliyun/install.sh 会把本文件复制到 /etc/systemd/system/ 并 daemon-reload，
#   但**不会** enable/start —— 先把 /etc/huakangos/huakangos.env 填好，再人工执行：
#       systemctl enable --now huakangos-controller
#
# 【权限取舍（明确接受）】
#   User=huakang 必须属于 docker 组。docker 组等价于 root：能挂载宿主机任意目录、
#   能读容器内的任何东西。控制器本来就要创建容器、挂载业务数据目录，因此这是本设计
#   明确接受的取舍。代价是：huakang 这个账号以及 /opt/huakangos/controller 里的代码
#   都落在信任边界内 —— 那里只能放人工审阅过的控制器代码，绝不放 AI 生成的候选代码。
#
#   AI 生成的代码只会出现在容器镜像里（由构建机构建、经隔离测试与人工审批），
#   在容器内以 --user 10001:10001 --cap-drop ALL --read-only 运行。

[Unit]
Description=HuaKangOS DealerDesk trusted release controller (maintenance.supervisor)
Documentation=file:///opt/huakangos/controller/docs/MAINTENANCE.md
After=network-online.target docker.service
Wants=network-online.target
# 没有 docker 就无法运行/切换业务容器，因此强依赖；docker 重启后本服务由 Restart=always 拉起，
# bootstrap 时会用 active.json 里记录的镜像重新启动业务容器。
Requires=docker.service

[Service]
Type=simple
User=huakang
Group=huakang
# docker 组权限来自 /etc/group 中 huakang 的附加组（install.sh 用 usermod -aG docker 添加）；
# 改过组之后必须 systemctl restart huakangos-controller 才生效。

WorkingDirectory=/opt/huakangos/controller
EnvironmentFile=/etc/huakangos/huakangos.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# 显式使用控制器 venv 的解释器；不要用 uvicorn，也不要直接跑 app.main:app。
ExecStart=/opt/huakangos/controller/.venv/bin/python -m maintenance.supervisor

Restart=always
RestartSec=5
# 停止时给 supervisor 留出停止业务容器（docker stop --time 20）与结束 worker 的时间。
TimeoutStopSec=60

# --- 加固（沿用 scripts/dealer.service.example 的姿态）----------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# 唯一需要写入的地方：业务 SQLite 数据目录与维护运行时目录（备份、active.json、
# status.json、PAUSED、switching.lock）。控制器代码与 venv 保持只读。
ReadWritePaths=/opt/huakangos/data /opt/huakangos/data/maintenance
# 只读挂载点（ProtectSystem=strict）不影响连接 AF_UNIX 套接字，
# 因此这里不需要为 docker.sock 额外开 ReadWritePaths。
UMask=0077
# 提示：UMask=0077 意味着 maintenance 目录下的文件（如 status.json）只有 huakang 可读，
# 容器内用户 10001 只能 stat 到 switching.lock 的存在（目录可穿越），
# 因此业务界面里的维护器状态可能显示默认文案。这是刻意的收紧，不是故障。

# 保证运行时目录存在且可被容器内用户穿越（容器以 10001:10001 运行）。
# 属主/属组由 deploy/aliyun/install.sh 设置（huakang:<容器 GID 10001>），这里只重申权限位。
ExecStartPre=/bin/mkdir -p /opt/huakangos/data/maintenance
ExecStartPre=/bin/chmod 2770 /opt/huakangos/data/maintenance

[Install]
WantedBy=multi-user.target