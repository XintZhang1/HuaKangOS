#!/bin/sh
# =============================================================================
# deploy/sg/hk_builder —— 新加坡构建机上的 SSH 强制命令（forced command）包装器
#
# 【本脚本做什么】
#   1. 由 sshd 以受限用户（默认 hkbuild）身份执行。客户端发来的动词与参数放在
#      $SSH_ORIGINAL_COMMAND 里，本脚本**只把它当数据**交给 Python：
#      maintenance/builder/__main__.py 用 shlex 解析，并只对固定动词白名单
#      （status/context/candidate/image/publish/revert/prune）分发，参数以
#      base64(JSON) 形式传递。$SSH_ORIGINAL_COMMAND 从不在 shell 里展开、eval 或拼接。
#   2. 载入 /etc/huakangos-builder.env（BuilderConfig 读取的全部 HKB_* 变量），
#      逐行 KEY=VALUE 解析，不做 shell 求值。
#   3. 切到固定的可信检出目录 $HKB_ROOT/src，用 builder venv 的解释器
#      exec python -m maintenance.builder。
#
# 【引用方式与不可更改的约束】
#   * 本文件在构建机用户的 ~/.ssh/authorized_keys 里通过
#         restrict,command="/opt/huakangos-builder/bin/hk_builder"
#     引用（见 deploy/sg/authorized_keys.snippet）。`restrict` 关闭 pty、端口转发、
#     agent 转发、X11、sftp 等；`command=` 使客户端的任何请求都变成执行本脚本。
#   * 本文件**绝不能被设为全局可写**（deploy/sg/install.sh 以 root:root 0755 安装）。
#     任何能改写它的人都能以 hkbuild 身份执行任意 docker/git 命令。
#   * 本脚本不写任何密钥、不打印任何密钥；私钥只在 hkbuild 家目录下，权限 600。
#   * 本脚本不碰 ufw / 全局代理 / /etc/environment，也不重启任何既有服务。
#
# 【故意不做什么】
#   * 不构建/测试 AI 候选以外的任何东西；不让 root 执行客户端的字符串。
#   * 不 docker pull：候选镜像构建用 --pull=false，可信测试镜像由 install.sh 预先构建。
# =============================================================================
set -eu
# Ubuntu 的 /bin/sh 是 dash，dash 不支持 pipefail（且对 set 的非法选项会直接退出），
# 因此先在子 shell 里探测，支持时才启用；本脚本不依赖管道退出码。
if (set -o pipefail) 2>/dev/null; then
  set -o pipefail
fi

BUILDER_ROOT='/opt/huakangos-builder'
BUILDER_ENV='/etc/huakangos-builder.env'
SRC_DIR="${BUILDER_ROOT}/src"
VENV_PY="${BUILDER_ROOT}/venv/bin/python"

# sshd 的强制命令环境里 PATH 可能是空的：docker / git / gzip / systemctl 都在 /usr/bin。
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

# --- 载入配置（必须是 hkbuild 可读的 600 文件；保持 LF、KEY=VALUE、值内无空格）---
if [ -r "${BUILDER_ENV}" ]; then
  while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in
      ''|'#'*) continue ;;
    esac
    case "${line}" in
      *=*) ;;
      *) continue ;;
    esac
    key=${line%%=*}
    value=${line#*=}
    case "${key}" in
      ''|*[!A-Za-z0-9_]*) continue ;;
    esac
    export "${key}=${value}"
  done < "${BUILDER_ENV}"
else
  echo "hk_builder: 无法读取 ${BUILDER_ENV}；请先在构建机上运行 deploy/sg/install.sh（该文件属主 hkbuild、权限 600）" >&2
  exit 3
fi

# 隔离测试容器以 --user 65534:65534 运行，并以只读方式挂载导出的候选源码树
# （maintenance/sandbox.py 的 docker_arguments），所以导出的目录/文件必须是 o+rX。
# 这里显式用 022；**绝不要改成 077**，否则测试容器读不到 /source，候选永远测不过。
umask 022

if [ ! -d "${SRC_DIR}" ]; then
  echo "hk_builder: 缺少可信检出目录 ${SRC_DIR}；请运行 deploy/sg/install.sh 并把 HKB_TRUSTED_SHA 指向的提交检出到该目录" >&2
  exit 3
fi
if [ ! -x "${VENV_PY}" ]; then
  echo "hk_builder: 缺少构建机 venv（${VENV_PY}）；请运行 deploy/sg/install.sh" >&2
  exit 3
fi

cd "${SRC_DIR}" || exit 3
PYTHONPATH="${SRC_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPATH

# 说明（与代码的差异，刻意在此补齐）：
# BuilderConfig 声明了 HKB_GIT_SSH_KEY，但 maintenance/gitops.py 只设置
# GIT_TERMINAL_PROMPT / GIT_LFS_SKIP_SMUDGE，仓库里没有任何 Python 代码读取该变量。
# 为了让它真正生效、并避免依赖 ~/.ssh/config 或首次连接信任（TOFU），这里在 shell 层
# 把它翻译成 git 认识的 GIT_SSH_COMMAND：只加 -i 与 IdentitiesOnly，不把任何客户端
# 数据放进命令字符串。没有这一步，git 会去用 hkbuild 的默认密钥。
if [ -n "${HKB_GIT_SSH_KEY:-}" ] && [ -f "${HKB_GIT_SSH_KEY}" ]; then
  GIT_SSH_COMMAND="ssh -i ${HKB_GIT_SSH_KEY} -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes"
  export GIT_SSH_COMMAND
fi
GIT_TERMINAL_PROMPT=0
export GIT_TERMINAL_PROMPT

exec "${VENV_PY}" -m maintenance.builder