# Never commit .env. Defaults bind to your own computer only.
DATABASE_URL=sqlite:///./data/dealer.db
APP_ENV=local
APP_TIMEZONE=Asia/Shanghai
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
COOKIE_SECURE=false
SESSION_HOURS=8
# The scheduler runs INSIDE this application, not in ChatGPT.
SCHEDULER_ENABLED=true
DAILY_REPORT_HOUR=0
DAILY_REPORT_MINUTE=15
# 00:15 generates the PREVIOUS business day's report. At most 7 missed days.
REPORT_CATCHUP_DAYS=7
# No information leaves your computer until both this switch and a key are set.
ALLOW_AI_EXTERNAL=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
AI_MAX_RECORDS=400
# These are configurable management REVIEW thresholds, not fraud judgments.
INVENTORY_AGING_DAYS=90
REPAIR_OVERDUE_DAYS=7
RECEIVABLE_GRACE_DAYS=3
LOW_GROSS_MARGIN_PERCENT=2
LARGE_CASH_AMOUNT_YUAN=50000
DISCOUNT_REVIEW_PERCENT=15

# Local service: a single trusted supervisor also handles release switches.
BIND_HOST=127.0.0.1
PORT=8000
# Optional maintenance. Both switches must be true before code/feedback is sent.
MAINTENANCE_ENABLED=false
ALLOW_CODE_EXTERNAL=false
# A DEDICATED repository containing this complete project; no credentials in URL.
MAINT_REPO_URL=
MAINT_REPO_WEB_URL=
MAINT_BASE_BRANCH=main
# Normally leave runtime path at data/maintenance. Never commit this directory.
# MAINT_RUNTIME_DIR=/absolute/private/path/dealerdesk-maintenance
MAINT_MAX_JOBS_PER_DAY=3
MAINT_APPROVAL_HOURS=24
MAINT_TEST_IMAGE=dealerdesk-tests:0.2
# Empty means reuse the regular DeepSeek model / key. Never send keys in chat.
DEEPSEEK_CODE_MODEL=
DEEPSEEK_CODE_API_KEY=
# Feishu SELF-BUILT APPLICATION bot, not a custom webhook bot.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APPROVER_OPEN_IDS=
# open_id for a private message; chat_id for an approval group containing the bot.
FEISHU_RECEIVE_ID_TYPE=open_id
FEISHU_RECEIVE_ID=
# Optional additional tenant check. An incorrect value blocks every approval.
FEISHU_TENANT_KEY=
