# Never commit .env. Defaults bind to your own computer only.
DATABASE_URL=sqlite:///./data/dealer.db
APP_ENV=local
APP_TIMEZONE=Asia/Shanghai
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
COOKIE_SECURE=false
SESSION_HOURS=8
# The scheduler runs INSIDE this application, not in ChatGPT.
SCHEDULER_ENABLED=true
# New uploads are isolated until scanning passes. structure_only is for explicit
# local synthetic trials and does not provide malware scanning. Production requires clamav.
FILE_SCAN_MODE=quarantine
# blob retains the bounded SQLite trial. private_local stores new immutable
# objects outside this repository; database and object directory restore together.
FILE_STORAGE_MODE=blob
PRIVATE_FILE_ROOT=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=5
# embedded is for a local single-process trial. Production web/worker both use worker.
# Launch worker separately with: python -m app.report_worker
SCHEDULER_MODE=embedded
DAILY_REPORT_HOUR=0
DAILY_REPORT_MINUTE=15
# 00:15 generates the PREVIOUS business day's report. At most 7 missed days.
REPORT_CATCHUP_DAYS=7
# No information leaves your computer until both this switch and a key are set.
ALLOW_AI_EXTERNAL=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
AI_MAX_RECORDS=400
# These are configurable management REVIEW thresholds, not fraud judgments.
INVENTORY_AGING_DAYS=90
REPAIR_OVERDUE_DAYS=7
RECEIVABLE_GRACE_DAYS=3
LOW_GROSS_MARGIN_PERCENT=2
LARGE_CASH_AMOUNT_YUAN=50000
DISCOUNT_REVIEW_PERCENT=15

# The application itself serves HTTP. No code-generation or auto-publishing service.
BIND_HOST=127.0.0.1
PORT=8000
# Evidence is private. Single attachment 10 MiB; per-case and per-store quotas below.
FILE_MAX_BYTES=10485760
FILE_CASE_LIMIT=100
FILE_STORE_QUOTA_MB=1024

# Historical business APIs are read-only. New orders/repairs use workflow actions.
LEGACY_BUSINESS_WRITE=false

# Assistant rollout switches default off. Follow-up requires Runtime.
# These switches never authorize automatic confirmation of business operations.
ASSISTANT_HOME_ENABLED=false
ASSISTANT_RUNTIME_ENABLED=false
ASSISTANT_FOLLOWUP_ENABLED=false
ASSISTANT_NOTIFICATIONS_ENABLED=false
